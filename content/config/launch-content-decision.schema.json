{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syntholo.com/schemas/launch-content-decision-v1.schema.json",
  "title": "Syntholo Launch Content Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "specialization",
    "productBibleDecision"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "specialization": {
      "type": "string",
      "enum": [
        "school",
        "work",
        "creation",
        "build"
      ]
    },
    "productBibleDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentPath",
        "decisionID",
        "decisionDate"
      ],
      "properties": {
        "documentPath": {
          "const": "docs/superpowers/specs/2026-08-25-syntholo-product-bible.md"
        },
        "decisionID": {
          "type": "string",
          "pattern": "^DEC-[1-9][0-9]*$"
        },
        "decisionDate": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
