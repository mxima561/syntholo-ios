rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userID) {
      return isSignedIn() && request.auth.uid == userID;
    }

    function hasExactKeys(data, keys) {
      return data.keys().hasOnly(keys)
        && data.keys().hasAll(keys);
    }

    function isBoundedString(value, minimum, maximum) {
      return value is string
        && value.size() >= minimum
        && value.size() <= maximum;
    }

    function isPositiveBoundedInteger(value) {
      return value is int
        && value >= 1
        && value <= 2147483647;
    }

    function isSchemaVersionOne(value) {
      return value is int && value == 1;
    }

    function isLaunchLocale(value) {
      return value is string && value == 'en-US';
    }

    function isLaunchLocaleToken(value) {
      return value is string && value == 'en-us';
    }

    function isStableCurriculumID(value) {
      return isBoundedString(value, 3, 64)
        && value.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$');
    }

    // Schema v1 is fixed to en-US/en-us. These derived maxima combine the
    // 64-character stable-ID bound with the exact launch-locale suffix.
    function isCurriculumPointerID(value) {
      return isBoundedString(value, 10, 71)
        && value.matches('^[a-z0-9]+(?:-[a-z0-9]+)*--en-us$');
    }

    function isCurriculumVersionID(value) {
      return isBoundedString(value, 14, 84)
        && value.matches(
          '^[a-z0-9]+(?:-[a-z0-9]+)*--en-us--v[1-9][0-9]{0,9}$'
        )
        && value.matches(
          '^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]--en-us--v[1-9][0-9]{0,9}$'
        );
    }

    function isCatalogVersionID(value) {
      return isCurriculumVersionID(value)
        && value.matches('^catalog--en-us--v[1-9][0-9]{0,9}$');
    }

    function isSHA256Digest(value) {
      return value is string
        && value.size() == 64
        && value.matches('^[a-f0-9]{64}$');
    }

    function isBoundedList(value, minimum, maximum) {
      return value is list
        && value.size() >= minimum
        && value.size() <= maximum;
    }

    function isValidFeatureConfiguration(data) {
      return hasExactKeys(data, [
          'schemaVersion',
          'minimumClientSchemaVersion',
          'defaultLocale',
          'supportedLocales',
          'catalogPointerIDs',
          'updatedAt'
        ])
        && isSchemaVersionOne(data.schemaVersion)
        && isPositiveBoundedInteger(data.minimumClientSchemaVersion)
        && isLaunchLocale(data.defaultLocale)
        && isBoundedList(data.supportedLocales, 1, 10)
        && data.supportedLocales.size() == 1
        && data.supportedLocales[0] == 'en-US'
        && isBoundedList(data.catalogPointerIDs, 1, 10)
        && data.catalogPointerIDs.size() == 1
        && data.catalogPointerIDs[0] == 'en-us'
        && data.updatedAt is timestamp;
    }

    function isValidCatalogPointer(data, localeToken) {
      return isLaunchLocaleToken(localeToken)
        && hasExactKeys(data, [
          'locale',
          'publishedCatalogVersionID',
          'schemaVersion',
          'minimumClientSchemaVersion',
          'updatedAt'
        ])
        && isLaunchLocale(data.locale)
        && isCatalogVersionID(data.publishedCatalogVersionID)
        && isSchemaVersionOne(data.schemaVersion)
        && isPositiveBoundedInteger(data.minimumClientSchemaVersion)
        && data.updatedAt is timestamp;
    }

    function isValidCatalogVersion(data, catalogVersionID) {
      return isCatalogVersionID(catalogVersionID)
        && hasExactKeys(data, [
          'catalogVersionID',
          'version',
          'locale',
          'publicationState',
          'schemaVersion',
          'minimumClientSchemaVersion',
          'programEntries',
          'contentDigest',
          'publishedAt'
        ])
        && data.catalogVersionID == catalogVersionID
        && isPositiveBoundedInteger(data.version)
        && isLaunchLocale(data.locale)
        && data.publicationState == 'published'
        && isSchemaVersionOne(data.schemaVersion)
        && isPositiveBoundedInteger(data.minimumClientSchemaVersion)
        && isBoundedList(data.programEntries, 1, 5)
        && isSHA256Digest(data.contentDigest)
        && data.publishedAt is timestamp;
    }

    function isValidProgramPointer(data, programPointerID) {
      return isCurriculumPointerID(programPointerID)
        && hasExactKeys(data, [
          'programPointerID',
          'programID',
          'locale',
          'publishedVersionID',
          'schemaVersion',
          'updatedAt'
        ])
        && data.programPointerID == programPointerID
        && isStableCurriculumID(data.programID)
        && isLaunchLocale(data.locale)
        && isCurriculumVersionID(data.publishedVersionID)
        && isSchemaVersionOne(data.schemaVersion)
        && data.updatedAt is timestamp;
    }

    function isValidProgramVersion(data, programVersionID) {
      return isCurriculumVersionID(programVersionID)
        && hasExactKeys(data, [
          'programVersionID',
          'programID',
          'version',
          'locale',
          'publicationState',
          'title',
          'promise',
          'catalogState',
          'schemaVersion',
          'minimumClientSchemaVersion',
          'moduleVersionIDs',
          'firstLessonVersionID',
          'contentDigest',
          'publishedAt'
        ])
        && data.programVersionID == programVersionID
        && isStableCurriculumID(data.programID)
        && isPositiveBoundedInteger(data.version)
        && isLaunchLocale(data.locale)
        && data.publicationState == 'published'
        && isBoundedString(data.title, 1, 120)
        && isBoundedString(data.promise, 1, 500)
        && data.catalogState in ['available', 'comingSoon']
        && isSchemaVersionOne(data.schemaVersion)
        && isPositiveBoundedInteger(data.minimumClientSchemaVersion)
        && isBoundedList(data.moduleVersionIDs, 0, 24)
        && (
          (
            data.catalogState == 'available'
            && data.moduleVersionIDs.size() >= 1
            && isCurriculumVersionID(data.firstLessonVersionID)
          )
          || (
            data.catalogState == 'comingSoon'
            && data.moduleVersionIDs.size() == 0
            && data.firstLessonVersionID == null
          )
        )
        && isSHA256Digest(data.contentDigest)
        && data.publishedAt is timestamp;
    }

    function isValidModuleVersion(data, moduleVersionID) {
      return isCurriculumVersionID(moduleVersionID)
        && hasExactKeys(data, [
          'moduleVersionID',
          'moduleID',
          'programID',
          'version',
          'locale',
          'publicationState',
          'title',
          'summary',
          'schemaVersion',
          'minimumClientSchemaVersion',
          'lessonVersionIDs',
          'contentDigest',
          'publishedAt'
        ])
        && data.moduleVersionID == moduleVersionID
        && isStableCurriculumID(data.moduleID)
        && isStableCurriculumID(data.programID)
        && isPositiveBoundedInteger(data.version)
        && isLaunchLocale(data.locale)
        && data.publicationState == 'published'
        && isBoundedString(data.title, 1, 120)
        && isBoundedString(data.summary, 1, 500)
        && isSchemaVersionOne(data.schemaVersion)
        && isPositiveBoundedInteger(data.minimumClientSchemaVersion)
        && isBoundedList(data.lessonVersionIDs, 1, 64)
        && isSHA256Digest(data.contentDigest)
        && data.publishedAt is timestamp;
    }

    function isValidLessonVersion(data, lessonVersionID) {
      return isCurriculumVersionID(lessonVersionID)
        && hasExactKeys(data, [
          'lessonVersionID',
          'lessonID',
          'programID',
          'moduleID',
          'version',
          'locale',
          'publicationState',
          'title',
          'objective',
          'expectedDurationMinutes',
          'prerequisiteLessonIDs',
          'completionRule',
          'blocks',
          'rubricVersionID',
          'assetVersionIDs',
          'schemaVersion',
          'minimumClientSchemaVersion',
          'contentDigest',
          'publishedAt'
        ])
        && data.lessonVersionID == lessonVersionID
        && isStableCurriculumID(data.lessonID)
        && isStableCurriculumID(data.programID)
        && isStableCurriculumID(data.moduleID)
        && isPositiveBoundedInteger(data.version)
        && isLaunchLocale(data.locale)
        && data.publicationState == 'published'
        && isBoundedString(data.title, 1, 120)
        && isBoundedString(data.objective, 1, 500)
        && data.expectedDurationMinutes is int
        && data.expectedDurationMinutes >= 1
        && data.expectedDurationMinutes <= 180
        && isBoundedList(data.prerequisiteLessonIDs, 0, 16)
        && data.completionRule is map
        && isBoundedList(data.blocks, 1, 40)
        && isCurriculumVersionID(data.rubricVersionID)
        && isBoundedList(data.assetVersionIDs, 0, 128)
        && isSchemaVersionOne(data.schemaVersion)
        && isPositiveBoundedInteger(data.minimumClientSchemaVersion)
        && isSHA256Digest(data.contentDigest)
        && data.publishedAt is timestamp;
    }

    function isValidRubricVersion(data, rubricVersionID) {
      return isCurriculumVersionID(rubricVersionID)
        && hasExactKeys(data, [
          'rubricVersionID',
          'rubricID',
          'version',
          'locale',
          'publicationState',
          'kind',
          'criteria',
          'clientScoringContract',
          'evaluationContractVersionID',
          'schemaVersion',
          'minimumClientSchemaVersion',
          'contentDigest',
          'publishedAt'
        ])
        && data.rubricVersionID == rubricVersionID
        && isStableCurriculumID(data.rubricID)
        && isPositiveBoundedInteger(data.version)
        && isLaunchLocale(data.locale)
        && data.publicationState == 'published'
        && data.kind == 'deterministic'
        && isBoundedList(data.criteria, 1, 12)
        && data.clientScoringContract is map
        && isCurriculumVersionID(data.evaluationContractVersionID)
        && isSchemaVersionOne(data.schemaVersion)
        && isPositiveBoundedInteger(data.minimumClientSchemaVersion)
        && isSHA256Digest(data.contentDigest)
        && data.publishedAt is timestamp;
    }

    function isValidAssetVersion(data, assetVersionID) {
      return isCurriculumVersionID(assetVersionID)
        && hasExactKeys(data, [
          'assetVersionID',
          'assetID',
          'version',
          'locale',
          'publicationState',
          'kind',
          'mimeType',
          'byteCount',
          'payloadDigest',
          'payload',
          'accessibilityDescription',
          'rights',
          'schemaVersion',
          'minimumClientSchemaVersion',
          'contentDigest',
          'publishedAt'
        ])
        && data.assetVersionID == assetVersionID
        && isStableCurriculumID(data.assetID)
        && isPositiveBoundedInteger(data.version)
        && isLaunchLocale(data.locale)
        && data.publicationState == 'published'
        && data.kind == 'diagramData'
        && data.mimeType == 'application/vnd.syntholo.diagram+json'
        && data.byteCount is int
        && data.byteCount >= 1
        && data.byteCount <= 131072
        && isSHA256Digest(data.payloadDigest)
        && data.payload is map
        && isBoundedString(data.accessibilityDescription, 1, 1000)
        && data.rights is map
        && isSchemaVersionOne(data.schemaVersion)
        && isPositiveBoundedInteger(data.minimumClientSchemaVersion)
        && isSHA256Digest(data.contentDigest)
        && data.publishedAt is timestamp;
    }

    function isValidHandle(handle) {
      return handle is string
        && handle.matches('^learner-[a-f0-9]{20}$');
    }

    function isValidAgeBand(ageBand) {
      return ageBand in ['13-17', '18+'];
    }

    function isValidUserDocument(data, userID) {
      return data.keys().hasOnly([
          'userID',
          'email',
          'displayName',
          'ageBand',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'userID',
          'email',
          'displayName',
          'ageBand',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && data.userID == userID
        && data.userID is string
        && (data.email == null || data.email is string)
        && (data.displayName == null || data.displayName is string)
        && data.ageBand is string
        && isValidAgeBand(data.ageBand)
        && data.schemaVersion == 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGoal(goal) {
      return goal in [
        'studySmarter',
        'workProductivity',
        'createContent',
        'buildWithAI'
      ];
    }

    function isValidExperience(experience) {
      return experience in ['beginner', 'intermediate', 'advanced'];
    }

    function isValidPath(path) {
      return path in ['school', 'work', 'creation', 'build'];
    }

    function isValidCoachMode(coachMode) {
      return coachMode in ['supportive', 'funny', 'strict', 'chill', 'socratic'];
    }

    function specializationProgramID(path) {
      return path == 'school'
        ? 'ai-school'
        : path == 'work'
          ? 'ai-work'
          : path == 'creation'
            ? 'ai-creation'
            : 'ai-build';
    }

    function hasRequiredPrograms(data) {
      return data.enrolledProgramIDs is list
        && data.enrolledProgramIDs.size() == 2
        && data.enrolledProgramIDs[0] == 'ai-foundations'
        && data.enrolledProgramIDs[1]
          == specializationProgramID(data.selectedPath);
    }

    function isValidPreferencesDocument(data, userID) {
      return data.keys().hasOnly([
          'userID',
          'goal',
          'experience',
          'selectedPath',
          'coachMode',
          'enrolledProgramIDs',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'userID',
          'goal',
          'experience',
          'selectedPath',
          'coachMode',
          'enrolledProgramIDs',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && data.userID == userID
        && data.userID is string
        && isValidGoal(data.goal)
        && isValidExperience(data.experience)
        && isValidPath(data.selectedPath)
        && isValidCoachMode(data.coachMode)
        && hasRequiredPrograms(data)
        && data.schemaVersion == 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicProfile(data, handle) {
      return data.keys().hasOnly(['handle', 'isDiscoverable'])
        && data.keys().hasAll(['handle', 'isDiscoverable'])
        && data.handle == handle
        && isValidHandle(data.handle)
        && data.isDiscoverable is bool;
    }

    function isValidHandleClaim(data, handle, userID) {
      return data.keys().hasOnly(['handle', 'ownerUID'])
        && data.keys().hasAll(['handle', 'ownerUID'])
        && data.handle == handle
        && isValidHandle(data.handle)
        && data.ownerUID == userID
        && data.ownerUID is string;
    }

    function hasCompleteInitialProfile(userID, handle) {
      let user = getAfter(
        /databases/$(database)/documents/users/$(userID)
      ).data;
      let preferences = getAfter(
        /databases/$(database)/documents/preferences/$(userID)
      ).data;
      let publicProfile = getAfter(
        /databases/$(database)/documents/publicProfiles/$(userID)
      ).data;
      let claim = getAfter(
        /databases/$(database)/documents/profileHandleClaims/$(handle)
      ).data;
      let directory = getAfter(
        /databases/$(database)/documents/publicProfileDirectory/$(handle)
      ).data;
      return isValidUserDocument(user, userID)
        && isValidPreferencesDocument(preferences, userID)
        && isValidPublicProfile(publicProfile, handle)
        && isValidHandleClaim(claim, handle, userID)
        && isValidPublicProfile(directory, handle)
        && publicProfile.isDiscoverable == false
        && directory.isDiscoverable == false
        && user.createdAt == request.time
        && user.updatedAt == request.time
        && preferences.createdAt == request.time
        && preferences.updatedAt == request.time;
    }

    function pairedPublicStateIsValid(userID, handle) {
      let publicProfile = getAfter(
        /databases/$(database)/documents/publicProfiles/$(userID)
      ).data;
      let directory = getAfter(
        /databases/$(database)/documents/publicProfileDirectory/$(handle)
      ).data;
      let claim = getAfter(
        /databases/$(database)/documents/profileHandleClaims/$(handle)
      ).data;
      return isValidPublicProfile(publicProfile, handle)
        && isValidPublicProfile(directory, handle)
        && publicProfile.isDiscoverable == directory.isDiscoverable
        && isValidHandleClaim(claim, handle, userID);
    }

    function adultOrHidden(userID, isDiscoverable) {
      return isDiscoverable == false
        || get(
          /databases/$(database)/documents/users/$(userID)
        ).data.ageBand == '18+';
    }

    match /users/{userID} {
      allow get: if isOwner(userID);
      allow list: if false;

      allow create: if isOwner(userID)
        && isValidUserDocument(request.resource.data, userID)
        && hasCompleteInitialProfile(
          userID,
          getAfter(
            /databases/$(database)/documents/publicProfiles/$(userID)
          ).data.handle
        );

      allow update: if isOwner(userID)
        && isValidUserDocument(request.resource.data, userID)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email',
          'displayName',
          'updatedAt'
        ])
        && request.resource.data.ageBand == resource.data.ageBand
        && request.resource.data.userID == resource.data.userID
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /preferences/{userID} {
      allow get: if isOwner(userID);
      allow list: if false;

      allow create: if isOwner(userID)
        && isValidPreferencesDocument(request.resource.data, userID)
        && hasCompleteInitialProfile(
          userID,
          getAfter(
            /databases/$(database)/documents/publicProfiles/$(userID)
          ).data.handle
        );

      allow update: if isOwner(userID)
        && isValidPreferencesDocument(request.resource.data, userID)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'goal',
          'experience',
          'selectedPath',
          'coachMode',
          'enrolledProgramIDs',
          'updatedAt'
        ])
        && request.resource.data.userID == resource.data.userID
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /publicProfiles/{userID} {
      allow get: if isOwner(userID)
        && isValidPublicProfile(resource.data, resource.data.handle);
      allow list: if false;

      allow create: if isOwner(userID)
        && isValidPublicProfile(request.resource.data, request.resource.data.handle)
        && hasCompleteInitialProfile(userID, request.resource.data.handle);

      allow update: if isOwner(userID)
        && isValidPublicProfile(request.resource.data, resource.data.handle)
        && request.resource.data.handle == resource.data.handle
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isDiscoverable'
        ])
        && pairedPublicStateIsValid(userID, resource.data.handle)
        && adultOrHidden(userID, request.resource.data.isDiscoverable);

      allow delete: if false;
    }

    match /profileHandleClaims/{handle} {
      allow get: if isSignedIn()
        && isValidHandleClaim(resource.data, handle, request.auth.uid);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidHandleClaim(request.resource.data, handle, request.auth.uid)
        && hasCompleteInitialProfile(request.auth.uid, handle);

      allow update: if isSignedIn()
        && isValidHandleClaim(resource.data, handle, request.auth.uid)
        && request.resource.data == resource.data
        && pairedPublicStateIsValid(request.auth.uid, handle);

      allow delete: if false;
    }

    match /publicProfileDirectory/{handle} {
      allow get: if isSignedIn()
        && (
          resource == null
          || isValidPublicProfile(resource.data, handle)
        );
      allow list: if false;

      allow create: if isSignedIn()
        && isValidPublicProfile(request.resource.data, handle)
        && getAfter(
          /databases/$(database)/documents/profileHandleClaims/$(handle)
        ).data.ownerUID == request.auth.uid
        && hasCompleteInitialProfile(request.auth.uid, handle);

      allow update: if isSignedIn()
        && isValidPublicProfile(request.resource.data, handle)
        && isValidHandleClaim(
          get(
            /databases/$(database)/documents/profileHandleClaims/$(handle)
          ).data,
          handle,
          request.auth.uid
        )
        && request.resource.data.handle == resource.data.handle
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isDiscoverable'
        ])
        && pairedPublicStateIsValid(request.auth.uid, handle)
        && adultOrHidden(
          request.auth.uid,
          request.resource.data.isDiscoverable
        );

      allow delete: if false;
    }

    match /featureConfiguration/curriculum {
      allow get: if isSignedIn()
        && (
          resource == null
          || isValidFeatureConfiguration(resource.data)
        );
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /catalogs/{localeToken} {
      allow get: if isSignedIn()
        && isLaunchLocaleToken(localeToken)
        && (
          resource == null
          || isValidCatalogPointer(resource.data, localeToken)
        );
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /catalogVersions/{catalogVersionID} {
      allow get: if isSignedIn()
        && isCatalogVersionID(catalogVersionID)
        && (
          resource == null
          || isValidCatalogVersion(resource.data, catalogVersionID)
        );
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /programs/{programPointerID} {
      allow get: if isSignedIn()
        && isCurriculumPointerID(programPointerID)
        && (
          resource == null
          || isValidProgramPointer(resource.data, programPointerID)
        );
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /programVersions/{programVersionID} {
      allow get: if isSignedIn()
        && isCurriculumVersionID(programVersionID)
        && (
          resource == null
          || isValidProgramVersion(resource.data, programVersionID)
        );
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /modules/{moduleVersionID} {
      allow get: if isSignedIn()
        && isCurriculumVersionID(moduleVersionID)
        && (
          resource == null
          || isValidModuleVersion(resource.data, moduleVersionID)
        );
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /lessonVersions/{lessonVersionID} {
      allow get: if isSignedIn()
        && isCurriculumVersionID(lessonVersionID)
        && (
          resource == null
          || isValidLessonVersion(resource.data, lessonVersionID)
        );
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /rubricVersions/{rubricVersionID} {
      allow get: if isSignedIn()
        && isCurriculumVersionID(rubricVersionID)
        && (
          resource == null
          || isValidRubricVersion(resource.data, rubricVersionID)
        );
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /assetVersions/{assetVersionID} {
      allow get: if isSignedIn()
        && isCurriculumVersionID(assetVersionID)
        && (
          resource == null
          || isValidAssetVersion(resource.data, assetVersionID)
        );
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /evaluationContractVersions/{documentID} {
      allow read, write: if false;
    }

    match /contentVersionHeads/{documentID} {
      allow read, write: if false;
    }

    match /contentPublicationAudit/{documentID} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
